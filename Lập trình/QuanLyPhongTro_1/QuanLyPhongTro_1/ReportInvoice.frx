<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.CreatorVersion="2026.1.0.0">

	<!-- ================= DATA ================= -->
	<Dictionary>
		<TableDataSource Name="Invoice" ReferenceName="Invoice">
			<Column Name="room_name" DataType="System.String"/>
			<Column Name="tenant_name" DataType="System.String"/>
			<Column Name="month" DataType="System.Int32"/>
			<Column Name="year" DataType="System.Int32"/>

			<Column Name="room_price" DataType="System.Decimal"/>
			<Column Name="electric_cost" DataType="System.Decimal"/>
			<Column Name="water_cost" DataType="System.Decimal"/>
			<Column Name="service_cost" DataType="System.Decimal"/>
			<Column Name="other_cost" DataType="System.Decimal"/>
			<Column Name="total_cost" DataType="System.Decimal"/>

			<Column Name="room_unit_price" DataType="System.Decimal"/>
			<Column Name="electric_price_per_kwh" DataType="System.Decimal"/>
			<Column Name="water_price_per_m3" DataType="System.Decimal"/>

			<Column Name="electric_old" DataType="System.Int32"/>
			<Column Name="electric_new" DataType="System.Int32"/>
			<Column Name="electric_usage" DataType="System.Int32"/>

			<Column Name="water_old" DataType="System.Int32"/>
			<Column Name="water_new" DataType="System.Int32"/>
			<Column Name="water_usage" DataType="System.Int32"/>

			<Column Name="service_detail" DataType="System.String"/>
		</TableDataSource>
	</Dictionary>

	<!-- ================= PAGE ================= -->
	<ReportPage Name="Page1" PaperWidth="210" PaperHeight="297"
				LeftMargin="15" RightMargin="15"
				TopMargin="15" BottomMargin="15">

		<!-- HEADER -->
		<PageHeaderBand Height="90">
			<TextObject Left="0" Top="0" Width="350" Height="30"
						Text="HỆ THỐNG NHÀ TRỌ HACTECH"
						Font="Segoe UI, 13pt, style=Bold"/>

			<TextObject Left="360" Top="0" Width="350" Height="40"
						Text="CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM&#13;&#10;Độc lập - Tự do - Hạnh phúc"
						HorzAlign="Center"
						Font="Segoe UI, 11pt, style=Bold"/>

			<TextObject Left="0" Top="50" Width="710" Height="30"
						Text="HÓA ĐƠN THUÊ PHÒNG"
						HorzAlign="Center"
						Font="Segoe UI, 16pt, style=Bold"/>
		</PageHeaderBand>

		<!-- BODY -->
		<DataBand DataSource="Invoice">

			<!-- INFO -->
			<TextObject Left="20" Top="10" Width="670" Height="24"
						Text="Phòng: [Invoice.room_name]"
						Font="Segoe UI, 12pt, style=Bold"/>

			<TextObject Left="20" Top="40" Width="670" Height="24"
						Text="Người thuê: [Invoice.tenant_name]"
						Font="Segoe UI, 12pt"/>

			<TextObject Left="20" Top="70" Width="670" Height="24"
						Text="Tháng: [Invoice.month]/[Invoice.year]"
						Font="Segoe UI, 12pt"/>

			<!-- ================= TABLE ================= -->
			<TableObject Left="20" Top="110" Width="670">
				<TableColumn Width="470"/>
				<TableColumn Width="200"/>

				<!-- HEADER -->
				<TableRow AutoSize="true">
					<TableCell Border.Lines="All" HorzAlign="Center" VertAlign="Center"
							   Font="Segoe UI, 12pt, style=Bold"
							   Text="Nội dung"/>
					<TableCell Border.Lines="All" HorzAlign="Center" VertAlign="Center"
							   Font="Segoe UI, 12pt, style=Bold"
							   Text="Số tiền (VNĐ)"/>
				</TableRow>

				<!-- ROOM -->
				<TableRow AutoSize="true">
					<TableCell Border.Lines="All" CanGrow="true"
							   Text="Tiền phòng&#13;&#10;Đơn giá: [Invoice.room_unit_price] đ"
							   Font="Segoe UI, 11pt"/>
					<TableCell Border.Lines="All" WordWrap="false"
							   HorzAlign="Right" VertAlign="Center"
							   Text="[Invoice.room_price]"
							   Font="Segoe UI, 11pt" Format="Number" Format.DecimalDigits="0"/>
				</TableRow>

				<!-- ELECTRIC -->
				<TableRow AutoSize="true">
					<TableCell Border.Lines="All" CanGrow="true"
							   Text="Tiền điện&#13;&#10;Chỉ số: [Invoice.electric_old] → [Invoice.electric_new]&#13;&#10;Tiêu thụ: [Invoice.electric_usage] kWh × [Invoice.electric_price_per_kwh]"
							   Font="Segoe UI, 11pt"/>
					<TableCell Border.Lines="All" WordWrap="false"
							   HorzAlign="Right" VertAlign="Center"
							   Text="[Invoice.electric_cost]"
							   Font="Segoe UI, 11pt" Format="Number" Format.DecimalDigits="0"/>
				</TableRow>

				<!-- WATER -->
				<TableRow AutoSize="true">
					<TableCell Border.Lines="All" CanGrow="true"
							   Text="Tiền nước&#13;&#10;Chỉ số: [Invoice.water_old] → [Invoice.water_new]&#13;&#10;Tiêu thụ: [Invoice.water_usage] m³ × [Invoice.water_price_per_m3]"
							   Font="Segoe UI, 11pt"/>
					<TableCell Border.Lines="All" WordWrap="false"
							   HorzAlign="Right" VertAlign="Center"
							   Text="[Invoice.water_cost]" 
							   Font="Segoe UI, 11pt" Format="Number" Format.DecimalDigits="0"/>
				</TableRow>

				<!-- SERVICE -->
				<TableRow AutoSize="true">
					<TableCell Border.Lines="All" CanGrow="true"
							   Text="Dịch vụ&#13;&#10;[Invoice.service_detail]"
							   Font="Segoe UI, 11pt"/>
					<TableCell Border.Lines="All" WordWrap="false"
							   HorzAlign="Right" VertAlign="Center"
							   Text="[Invoice.service_cost]"
							   Font="Segoe UI, 11pt" Format="Number" Format.DecimalDigits="0"/>
				</TableRow>

				<!-- OTHER -->
				<TableRow AutoSize="true">
					<TableCell Border.Lines="All"
							   Text="Chi phí khác"
							   Font="Segoe UI, 11pt"/>
					<TableCell Border.Lines="All" WordWrap="false"
							   HorzAlign="Right" VertAlign="Center"
							   Text="[Invoice.other_cost]"
							   Font="Segoe UI, 11pt" Format="Number" Format.DecimalDigits="0"/>
				</TableRow>

				<!-- TOTAL -->
				<TableRow AutoSize="true">
					<TableCell Border.Lines="All"
							   Font="Segoe UI, 13pt, style=Bold"
							   Text="TỔNG CỘNG"/>
					<TableCell Border.Lines="All" WordWrap="false"
							   HorzAlign="Right" VertAlign="Center"
							   Font="Segoe UI, 13pt, style=Bold"
							   Text="[Invoice.total_cost]"
							   Format="Number" Format.DecimalDigits="0"/>
				</TableRow>

			</TableObject>

			<!-- SIGN -->
			<TextObject Left="420" Top="150" Width="280" Height="18"
						Text="Ngày ..... tháng ..... năm ....."
						HorzAlign="Center"
						Font="Segoe UI, 10pt"/>

			<TextObject Left="420" Top="170" Width="280" Height="45"
						Text="Người lập hóa đơn&#13;&#10;(Ký và ghi rõ họ tên)"
						HorzAlign="Center"
						Font="Segoe UI, 10pt"/>

		</DataBand>

	</ReportPage>
</Report>
