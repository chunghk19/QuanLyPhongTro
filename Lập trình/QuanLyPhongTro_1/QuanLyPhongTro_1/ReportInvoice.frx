<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.CreatorVersion="2026.1.0.0">

	<!-- ================= DATA ================= -->
	<Dictionary>
		<TableDataSource Name="Invoice" ReferenceName="Invoice">
			<Column Name="room_name" DataType="System.String"/>
			<Column Name="tenant_name" DataType="System.String"/>
			<Column Name="month" DataType="System.Int32"/>
			<Column Name="year" DataType="System.Int32"/>
			<Column Name="room_price" DataType="System.Decimal"/>
			<Column Name="electric_cost" DataType="System.Decimal"/>
			<Column Name="water_cost" DataType="System.Decimal"/>
			<Column Name="service_cost" DataType="System.Decimal"/>
			<Column Name="other_cost" DataType="System.Decimal"/>
			<Column Name="total_cost" DataType="System.Decimal"/>
			<Column Name="status" DataType="System.String"/>
		</TableDataSource>
	</Dictionary>

	<!-- ================= PAGE ================= -->
	<ReportPage Name="Page1"
				PaperWidth="210"
				PaperHeight="297"
				LeftMargin="15"
				RightMargin="15"
				TopMargin="15"
				BottomMargin="15">

		<!-- ================= HEADER ================= -->
		<PageHeaderBand Height="90">

			<TextObject Left="0" Top="0" Width="350" Height="30"
						Text="HỆ THỐNG NHÀ TRỌ HACTECH"
						Font="Segoe UI, 12pt, style=Bold"/>

			<TextObject Left="360" Top="0" Width="350" Height="40"
						Text="CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM&#13;&#10;Độc lập - Tự do - Hạnh phúc"
						HorzAlign="Center"
						Font="Segoe UI, 11pt, style=Bold"/>

			<TextObject Left="0" Top="50" Width="710" Height="30"
						Text="HÓA ĐƠN THUÊ PHÒNG"
						HorzAlign="Center"
						Font="Segoe UI, 16pt, style=Bold"/>
		</PageHeaderBand>

		<!-- ================= INFO ================= -->
		<ReportTitleBand Height="70">
			<TextObject Left="0" Top="0" Width="350" Height="20"
						Text="Phòng: [Invoice.room_name]"
						Font="Segoe UI, 10pt, style=Bold"/>

			<TextObject Left="0" Top="22" Width="350" Height="20"
						Text="Người thuê: [Invoice.tenant_name]"
						Font="Segoe UI, 10pt"/>

			<TextObject Left="400" Top="0" Width="300" Height="20"
						Text="Tháng: [Invoice.month]/[Invoice.year]"
						HorzAlign="Right"
						Font="Segoe UI, 10pt"/>

			<TextObject Left="400" Top="22" Width="300" Height="20"
						Text="Trạng thái: [Invoice.status]"
						HorzAlign="Right"
						Font="Segoe UI, 10pt, style=Bold"/>
		</ReportTitleBand>

		<!-- ================= TABLE ================= -->
		<DataBand Height="210" DataSource="Invoice">

			<TextObject Left="0" Top="0" Width="450" Height="25"
						Border.Lines="All"
						Text="Nội dung"
						HorzAlign="Center"
						Font="Segoe UI, 10pt, style=Bold"/>

			<TextObject Left="450" Top="0" Width="260" Height="25"
						Border.Lines="All"
						Text="Số tiền (VNĐ)"
						HorzAlign="Center"
						Font="Segoe UI, 10pt, style=Bold"/>

			<TextObject Left="0" Top="25" Width="450" Height="25" Border.Lines="All" Text="Tiền phòng"/>
			<TextObject Left="450" Top="25" Width="260" Height="25" Border.Lines="All"
						Text="[Invoice.room_price]" HorzAlign="Right"
						Format="Number" Format.UseLocale="true"/>

			<TextObject Left="0" Top="50" Width="450" Height="25" Border.Lines="All" Text="Tiền điện"/>
			<TextObject Left="450" Top="50" Width="260" Height="25" Border.Lines="All"
						Text="[Invoice.electric_cost]" HorzAlign="Right"
						Format="Number" Format.UseLocale="true"/>

			<TextObject Left="0" Top="75" Width="450" Height="25" Border.Lines="All" Text="Tiền nước"/>
			<TextObject Left="450" Top="75" Width="260" Height="25" Border.Lines="All"
						Text="[Invoice.water_cost]" HorzAlign="Right"
						Format="Number" Format.UseLocale="true"/>

			<TextObject Left="0" Top="100" Width="450" Height="25" Border.Lines="All" Text="Dịch vụ"/>
			<TextObject Left="450" Top="100" Width="260" Height="25" Border.Lines="All"
						Text="[Invoice.service_cost]" HorzAlign="Right"
						Format="Number" Format.UseLocale="true"/>

			<TextObject Left="0" Top="125" Width="450" Height="25" Border.Lines="All" Text="Chi phí khác"/>
			<TextObject Left="450" Top="125" Width="260" Height="25" Border.Lines="All"
						Text="[Invoice.other_cost]" HorzAlign="Right"
						Format="Number" Format.UseLocale="true"/>

			<TextObject Left="0" Top="155" Width="450" Height="35" Border.Lines="All"
						Text="TỔNG TIỀN"
						Font="Segoe UI, 11pt, style=Bold"/>

			<TextObject Left="450" Top="155" Width="260" Height="35" Border.Lines="All"
						Text="[Invoice.total_cost]"
						HorzAlign="Right"
						Font="Segoe UI, 11pt, style=Bold"
						Format="Number" Format.UseLocale="true"/>
		</DataBand>

		<!-- ================= SIGNATURE ================= -->
		<ReportSummaryBand Height="100">

			<TextObject Left="0" Top="10" Width="300" Height="60"
						Text="Người lập hóa đơn&#13;&#10;(Ký và ghi rõ họ tên)"
						HorzAlign="Center"
						Font="Segoe UI, 10pt"/>

			<TextObject Left="410" Top="10" Width="300" Height="60"
						Text="Khách hàng&#13;&#10;(Ký và ghi rõ họ tên)"
						HorzAlign="Center"
						Font="Segoe UI, 10pt"/>
		</ReportSummaryBand>

		<!-- ================= FOOTER ================= -->
		<PageFooterBand Height="20">
			<TextObject Left="0" Top="0" Width="710" Height="20"
						Text="Trang [Page#] / [TotalPages#]"
						HorzAlign="Right"
						Font="Segoe UI, 9pt"/>
		</PageFooterBand>

	</ReportPage>
</Report>
