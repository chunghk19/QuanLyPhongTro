<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp">

	<Dictionary>
		<TableDataSource Name="Contracts" ReferenceName="Contracts">
			<Column Name="contract_id" DataType="System.Int32"/>
			<Column Name="full_name" DataType="System.String"/>
			<Column Name="phone" DataType="System.String"/>
			<Column Name="id_card" DataType="System.String"/>
			<Column Name="address" DataType="System.String"/>
			<Column Name="room_name" DataType="System.String"/>
			<Column Name="start_date" DataType="System.DateTime"/>
			<Column Name="end_date" DataType="System.DateTime"/>
			<Column Name="deposit" DataType="System.Decimal"/>
			<Column Name="room_price" DataType="System.Decimal"/>
		</TableDataSource>
	</Dictionary>

	<ReportPage Name="Page1"
	            PaperWidth="210" PaperHeight="297"
	            LeftMargin="15" RightMargin="15"
	            TopMargin="15" BottomMargin="15">

		<!-- ================= HEADER ================= -->
		<PageHeaderBand Height="90">

			<TextObject Left="0" Top="0" Width="350" Height="30"
			            Text="HỆ THỐNG NHÀ TRỌ HACTECH"
			            Font="Segoe UI, 13pt, style=Bold"/>

			<TextObject Left="360" Top="0" Width="350" Height="40"
			            Text="CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM&#13;&#10;Độc lập - Tự do - Hạnh phúc"
			            HorzAlign="Center"
			            Font="Segoe UI, 11pt, style=Bold"/>

			<TextObject Left="0" Top="50" Width="710" Height="30"
			            Text="BÁO CÁO HỢP ĐỒNG THUÊ PHÒNG"
			            HorzAlign="Center"
			            Font="Segoe UI, 16pt, style=Bold"/>
		</PageHeaderBand>

		<!-- ================= BODY ================= -->
		<DataBand Name="Data1"
		          DataSource="Contracts"
		          StartNewPage="true"
		          Height="360">

			<!-- ===== THÔNG TIN KHÁCH THUÊ ===== -->
			<TextObject Left="20" Top="5" Width="670" Height="22"
			            Text="I. THÔNG TIN KHÁCH THUÊ"
			            Font="Segoe UI, 12pt, style=Bold"/>

			<TextObject Left="20" Top="35" Width="670" Height="24"
			            Text="Tên khách thuê: [Contracts.full_name]"
			            Font="Segoe UI, 12pt"/>

			<TextObject Left="20" Top="65" Width="670" Height="24"
			            Text="Số điện thoại: [Contracts.phone]"
			            Font="Segoe UI, 12pt"/>

			<TextObject Left="20" Top="95" Width="670" Height="24"
			            Text="CCCD: [Contracts.id_card]"
			            Font="Segoe UI, 12pt"/>

			<TextObject Left="20" Top="125" Width="670" Height="24"
			            Text="Phòng thuê: [Contracts.room_name]"
			            Font="Segoe UI, 12pt"/>

			<TextObject Left="20" Top="155" Width="670" Height="40"
			            Text="Địa chỉ: [Contracts.address]"
			            WordWrap="true"
			            Font="Segoe UI, 12pt"/>

			<!-- ===== THÔNG TIN HỢP ĐỒNG ===== -->
			<TextObject Left="20" Top="205" Width="670" Height="22"
			            Text="II. THÔNG TIN HỢP ĐỒNG"
			            Font="Segoe UI, 12pt, style=Bold"/>

			<TextObject Left="20" Top="235" Width="670" Height="24"
			            Text="Ngày bắt đầu: [Contracts.start_date]"
			            Font="Segoe UI, 12pt"/>

			<TextObject Left="20" Top="265" Width="670" Height="24"
			            Text="Ngày kết thúc: [Contracts.end_date]"
			            Font="Segoe UI, 12pt"/>

			<TextObject Left="20" Top="295" Width="670" Height="24"
			            Text="Tiền đặt cọc: [Contracts.deposit]"
						Format="Number" Format.DecimalDigits="0"
			            Font="Segoe UI, 12pt"/>

			<TextObject Left="20" Top="325" Width="670" Height="24"
			            Text="Giá thuê phòng: [Contracts.room_price]"
						Format="Number" Format.DecimalDigits="0"
			            Font="Segoe UI, 12pt"/>

			<!-- ===== CHỮ KÝ ===== -->
			<TextObject Left="418" Top="355" Width="300" Height="18"
			            Text="Ngày ..... tháng ..... năm ....."
			            HorzAlign="Center"
			            Font="Segoe UI, 10pt"/>

			<TextObject Left="420" Top="375" Width="280" Height="45"
			            Text="Người lập báo cáo&#13;&#10;(Ký và ghi rõ họ tên)"
			            HorzAlign="Center"
			            Font="Segoe UI, 10pt"/>
		</DataBand>

		<!-- ================= FOOTER ================= -->
		<PageFooterBand Height="20">
			<TextObject Left="0" Top="0" Width="710" Height="20"
			            Text="Trang [Page#] / [TotalPages#]"
			            HorzAlign="Right"
			            Font="Segoe UI, 9pt"/>
		</PageFooterBand>

	</ReportPage>
</Report>
