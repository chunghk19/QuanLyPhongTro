<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.CreatorVersion="2026.1.0.0">

	<!-- ================= DATA ================= -->
	<Dictionary>
		<TableDataSource Name="TenantRoom" ReferenceName="TenantRoom">
			<Column Name="full_name" DataType="System.String"/>
			<Column Name="phone" DataType="System.String"/>
			<Column Name="id_card" DataType="System.String"/>
			<Column Name="address" DataType="System.String"/>
			<Column Name="room_name" DataType="System.String"/>
			<Column Name="price" DataType="System.Decimal"/>
			<Column Name="contract_status" DataType="System.String"/>
		</TableDataSource>
	</Dictionary>

	<!-- ================= PAGE ================= -->
	<ReportPage Name="Page1"
				PaperWidth="210"
				PaperHeight="297"
				LeftMargin="15"
				RightMargin="15"
				TopMargin="15"
				BottomMargin="15">

		<!-- ================= HEADER HÀNH CHÍNH ================= -->
		<PageHeaderBand Height="90">

			<!-- Trái -->
			<TextObject Left="0" Top="0" Width="350" Height="30"
			            Text="HỆ THỐNG NHÀ TRỌ HACTECH"
			            Font="Segoe UI, 12pt, style=Bold"/>

			<!-- Phải -->
			<TextObject Left="360" Top="0" Width="350" Height="40"
			            Text="CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM&#13;&#10;Độc lập - Tự do - Hạnh phúc"
			            Font="Segoe UI, 11pt, style=Bold"
			            HorzAlign="Center"/>

			<!-- Tên báo cáo -->
			<TextObject Left="0" Top="50" Width="710" Height="30"
			            Text="BÁO CÁO DANH SÁCH PHÒNG"
			            Font="Segoe UI, 15pt, style=Bold"
			            HorzAlign="Center"/>
		</PageHeaderBand>

		<!-- ================= COLUMN HEADER ================= -->
		<ColumnHeaderBand Height="25">

			<TextObject Left="0" Top="0" Width="150" Height="25"
						Border.Lines="All"
						Text="Tên khách"
						HorzAlign="Center"
						Font="Segoe UI, 10pt, style=Bold"/>

			<TextObject Left="150" Top="0" Width="90" Height="25"
						Border.Lines="All"
						Text="SĐT"
						HorzAlign="Center"
						Font="Segoe UI, 10pt, style=Bold"/>

			<TextObject Left="240" Top="0" Width="100" Height="25"
						Border.Lines="All"
						Text="CCCD"
						HorzAlign="Center"
						Font="Segoe UI, 10pt, style=Bold"/>

			<TextObject Left="340" Top="0" Width="180" Height="25"
						Border.Lines="All"
						Text="Địa chỉ"
						HorzAlign="Center"
						Font="Segoe UI, 10pt, style=Bold"/>

			<TextObject Left="520" Top="0" Width="198" Height="25"
						Border.Lines="All"
						Text="Phòng thuê"
						HorzAlign="Center"
						Font="Segoe UI, 10pt, style=Bold"/>

		</ColumnHeaderBand>

		<!-- ================= DATA ================= -->
		<DataBand Name="Data1" DataSource="TenantRoom" Height="25" CanGrow="true">

			<TextObject Left="0" Top="0" Width="150" Height="25"
						Border.Lines="All"
						Text="[TenantRoom.full_name]"
						Font="Segoe UI, 10pt"
						WordWrap="true"
						CanGrow="true"/>

			<TextObject Left="150" Top="0" Width="90" Height="25"
						Border.Lines="All"
						Text="[TenantRoom.phone]"
						Font="Segoe UI, 10pt"/>

			<TextObject Left="240" Top="0" Width="100" Height="25"
						Border.Lines="All"
						Text="[TenantRoom.id_card]"
						Font="Segoe UI, 10pt"/>

			<TextObject Left="340" Top="0" Width="180" Height="25"
						Border.Lines="All"
						Text="[TenantRoom.address]"
						Font="Segoe UI, 10pt"
						WordWrap="true"
						CanGrow="true"/>

			<TextObject Left="520" Top="0" Width="198" Height="25"
						Border.Lines="All"
						Text="[TenantRoom.room_name]"
						HorzAlign="Center"
						Font="Segoe UI, 10pt"/>

		</DataBand>

		<!-- ================= SIGNATURE ================= -->
		<ReportSummaryBand Height="90">

			<TextObject Left="418" Top="10" Width="300" Height="20"
						Text="Hà Nội, ngày … tháng … năm …"
						HorzAlign="Center"
						Font="Segoe UI, 9pt, style=Italic"/>

			<TextObject Left="418" Top="35" Width="300" Height="20"
						Text="Người lập báo cáo"
						HorzAlign="Center"
						Font="Segoe UI, 10pt, style=Bold"/>

			<TextObject Left="418" Top="60" Width="300" Height="20"
						Text="(Ký và ghi rõ họ tên)"
						HorzAlign="Center"
						Font="Segoe UI, 9pt, style=Italic"/>

		</ReportSummaryBand>

		<!-- ================= FOOTER ================= -->
		<PageFooterBand Height="20">
			<TextObject Left="0" Top="0" Width="718" Height="20"
						Text="Trang [Page#] / [TotalPages#]"
						HorzAlign="Right"
						Font="Segoe UI, 9pt"/>
		</PageFooterBand>

	</ReportPage>
</Report>
